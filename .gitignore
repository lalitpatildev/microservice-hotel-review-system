# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
/classes/

# Eclipse
.project
.classpath
.settings/
.factorypath
.springBeans
.sts4-cache/
bin/
*.launch

# VS Code
.vscode/
*.code-workspace

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/nbactions.xml

# ==========================================
# 2. Build Tools (Maven & Gradle)
# ==========================================

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# Note: We typically DO NOT ignore mvnw or .mvn/wrapper so others can build easily.

# Gradle
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar

# ==========================================
# 3. Environment & Security (CRITICAL for Public Repos)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.properties
*.yml
# Allow standard Spring config but ignore secret-heavy ones
!src/main/resources/*.properties
!src/main/resources/*.yml
application-local.properties
application-dev.properties

# ==========================================
# 4. OS & System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.bak

# ==========================================
# 5. Logs & Temporary Files
# ==========================================
*.log
logs/
temp/
tmp/
*.swp